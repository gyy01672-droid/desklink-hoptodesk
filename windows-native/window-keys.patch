diff --git a/src/ui_session_interface/window_keys.rs b/src/ui_session_interface/window_keys.rs
new file mode 100644
index 0000000..f308c80
--- /dev/null
+++ b/src/ui_session_interface/window_keys.rs
@@ -0,0 +1,118 @@
+const SCANS: [u32; 13] = [0x01, 0x3b, 0x3c, 0x3d, 0x3e, 0x3f, 0x40, 0x41, 0x42, 0x43, 0x44, 0x57, 0x58];
+
+#[derive(Default)]
+pub(crate) struct WindowKeys {
+    pair: (u32, u32),
+    held: [Option<u32>; 13],
+    released_on_blur: [bool; 13],
+}
+
+impl WindowKeys {
+    pub(super) fn eligible(code: u32) -> bool {
+        SCANS.contains(&code)
+    }
+
+    pub(super) fn selection(&self) -> Vec<i32> {
+        vec![self.pair.0 as i32, self.pair.1 as i32]
+    }
+
+    pub(super) fn select(&mut self, a: u32, b: u32) -> bool {
+        let pair = if (a, b) == (0, 0) || (Self::eligible(a) && Self::eligible(b) && a != b) {
+            (a, b)
+        } else {
+            return false;
+        };
+        if self.pair != pair && self.held.iter().any(Option::is_some) {
+            return false;
+        }
+        self.pair = pair;
+        true
+    }
+
+    pub(super) fn event(&mut self, code: u32, down: bool, in_window: impl FnOnce() -> bool) -> Option<u32> {
+        let Some(i) = SCANS.iter().position(|&key| key == code) else { return Some(code) };
+        if !down {
+            if let Some(sent) = self.held[i].take() {
+                return Some(sent);
+            }
+            return (!std::mem::take(&mut self.released_on_blur[i])).then_some(code);
+        }
+        if let Some(sent) = self.held[i] {
+            return (sent == code || in_window()).then_some(sent);
+        }
+        let (a, b) = self.pair;
+        let mapped = if code == a { b } else if code == b { a } else { code };
+        let sent = if mapped != code && in_window() { mapped } else { code };
+        self.released_on_blur[i] = false;
+        self.held[i] = Some(sent);
+        Some(sent)
+    }
+
+    pub(super) fn release_mapped(&mut self) -> Vec<u32> {
+        let mut release = Vec::new();
+        for (i, code) in SCANS.iter().enumerate() {
+            if let Some(sent) = self.held[i].take() {
+                if sent != *code {
+                    release.push(sent);
+                    self.released_on_blur[i] = true;
+                }
+            }
+        }
+        release
+    }
+
+    pub(super) fn reset_connection(&mut self) {
+        self.held.fill(None);
+        self.released_on_blur.fill(false);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pairs_swap_each_down_repeat_and_up_and_do_not_change_while_held() {
+        let mut keys = WindowKeys::default();
+        for a in SCANS {
+            for b in SCANS {
+                if a == b { continue; }
+                assert!(keys.select(a, b));
+                assert_eq!(keys.event(a, true, || true), Some(b));
+                assert_eq!(keys.event(a, true, || true), Some(b));
+                assert_eq!(keys.event(b, true, || true), Some(a));
+                assert!(!keys.select(0, 0));
+                assert_eq!(keys.event(b, false, || false), Some(a));
+                assert_eq!(keys.event(a, false, || false), Some(b));
+            }
+        }
+    }
+
+    #[test]
+    fn blur_releases_the_sent_key_once_and_a_new_press_is_independent() {
+        let mut keys = WindowKeys::default();
+        assert!(keys.select(1, 0x3b));
+        assert_eq!(keys.event(1, true, || true), Some(0x3b));
+        assert_eq!(keys.release_mapped(), vec![0x3b]);
+        assert!(keys.release_mapped().is_empty());
+        assert_eq!(keys.event(1, false, || false), None);
+        assert_eq!(keys.event(1, true, || false), Some(1));
+        assert_eq!(keys.event(1, false, || true), Some(1));
+        assert_eq!(keys.event(1, true, || true), Some(0x3b));
+        keys.reset_connection();
+        assert!(keys.release_mapped().is_empty());
+        assert_eq!(keys.selection(), vec![1, 0x3b]);
+    }
+
+    #[test]
+    fn default_typing_locks_and_modifiers_pass_through() {
+        let mut keys = WindowKeys::default();
+        assert!(!keys.select(1, 1));
+        assert!(!keys.select(0x1d, 0x3a));
+        for code in [0x01, 0x1d, 0x3a, 0x10, 0xe01d, 0x58] {
+            assert_eq!(keys.event(code, true, || panic!("unexpected focus check")), Some(code));
+            assert_eq!(keys.event(code, false, || false), Some(code));
+        }
+        assert!(keys.release_mapped().is_empty());
+    }
+}
