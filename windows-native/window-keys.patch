+function windowKeyChoices(current) {
+    var scans = [0, 1, 59, 60, 61, 62, 63, 64, 65, 66, 67, 68, 87, 88];
+    var options = "";
+    for (var i = 0; i < scans.length; i++) {
+        var label = i == 0 ? translate("Off") : (i == 1 ? "Esc" : "F" + (i - 1));
+        options += "<option value='" + scans[i] + "'" + (scans[i] == current ? " selected" : "") + ">" + label + "</option>";
+    }
+    return options;
+}
+
+function editWindowKeyPair() {
+    if (handler.get_keyboard_mode() != "map") {
+        showSessionToast(translate("Choose Remote layout to swap physical keys."), 2600ms);
+        return;
+    }
+    var pair = handler.get_window_key_selection();
+    var content = "<div class='form'><div>" + translate("Choose two different keys. Select Off to restore the original keys.") + "</div>" +
+        "<div><select name='first'>" + windowKeyChoices(pair[0]) + "</select> ↔ <select name='second'>" +
+        windowKeyChoices(pair[1]) + "</select></div></div>";
+    msgbox("custom-window-keys", "Swap two keys in this window", content, "", function(res=null) {
+        if (!res) return;
+        var a = "" + res.first;
+        var b = "" + res.second;
+        if (a == "0" || b == "0") { a = "0"; b = "0"; }
+        if (a != "0" && a == b) return translate("Choose two different keys.");
+        if (!handler.set_window_key_selection(a, b)) return translate("Release held keys and try again.");
+    });
+}
