diff --git a/src/client/traffic.rs b/src/client/traffic.rs
new file mode 100644
index 0000000..3546dd7
--- /dev/null
+++ b/src/client/traffic.rs
@@ -0,0 +1,58 @@
+/// Payload returned by Stream::next for one viewer connection, in either route.
+#[derive(Default)]
+pub(super) struct ReceivedTraffic {
+    total: u64,
+    last_sample: u64,
+}
+
+impl ReceivedTraffic {
+    pub(super) fn add(&mut self, bytes: usize) {
+        self.total = self.total.saturating_add(bytes as u64);
+    }
+
+    pub(super) fn sample_bytes(&mut self) -> u64 {
+        let bytes = self.total - self.last_sample;
+        self.last_sample = self.total;
+        bytes
+    }
+
+    pub(super) fn display_total(&self) -> String {
+        let bytes = self.total;
+        for (unit, name) in [(1u64 << 30, "GiB"), (1u64 << 20, "MiB"), (1u64 << 10, "KiB")] {
+            if bytes >= unit {
+                return format!("{:.2} {}", bytes as f64 / unit as f64, name);
+            }
+        }
+        format!("{} B", bytes)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rate_samples_do_not_reset_the_session_total() {
+        let mut rx = ReceivedTraffic::default();
+        assert_eq!(rx.display_total(), "0 B");
+        rx.add(1023);
+        assert_eq!(rx.sample_bytes(), 1023);
+        rx.add(1);
+        assert_eq!(rx.sample_bytes(), 1);
+        assert_eq!(rx.sample_bytes(), 0);
+        assert_eq!(rx.display_total(), "1.00 KiB");
+        rx.add((5 << 20) - 1024);
+        assert_eq!(rx.display_total(), "5.00 MiB");
+    }
+
+    #[test]
+    fn long_sessions_and_separate_connections() {
+        let mut active = ReceivedTraffic::default();
+        for _ in 0..5 {
+            active.add(1 << 30);
+            assert_eq!(active.sample_bytes(), 1 << 30);
+        }
+        assert_eq!(active.display_total(), "5.00 GiB");
+        assert_eq!(ReceivedTraffic::default().display_total(), "0 B");
+    }
+}
