diff --git a/src/ui/remote.tis b/src/ui/remote.tis
index e6850cb..99bea65 100644
--- a/src/ui/remote.tis
+++ b/src/ui/remote.tis
@@ -1313,6 +1313,46 @@ function self.closing() {
 var qualityMonitor;
 var qualityMonitorData = [];
 
+function qualitySample(value, unit) {
+    if (value === null || value === undefined) return "-";
+    return "" + value + unit;
+}
+
+function qualityReceiveRate() {
+    var speed = qualityMonitorData[0];
+    return speed ? speed.replace("kB/s", " KiB/s") : "-";
+}
+
+function qualityRtt() {
+    var delay = qualityMonitorData[2];
+    // The host sends 0 before its first reply; sub-millisecond RTT also rounds to 0.
+    if (delay === 0) return translate("Pending or under 1 ms");
+    return qualitySample(delay, " ms");
+}
+
+function buildPerformanceReport() {
+    var direct = header.direct_connection;
+    var route = "-";
+    if (direct === true) route = translate("Direct Connection");
+    if (direct === false) route = translate("Relay Connection");
+    return [
+        translate("Session performance"),
+        translate("Connection path") + ": " + route,
+        translate("Host measured round-trip time") + ": " + qualityRtt(),
+        translate("Requested frame rate limit") + ": " + qualitySample(handler.get_custom_fps(), " FPS"),
+        translate("Decoded output (one video stream)") + ": " + qualitySample(qualityMonitorData[1], " FPS"),
+        translate("Video bitrate target") + ": " + qualitySample(qualityMonitorData[3], " kbps"),
+        translate("Codec") + ": " + qualitySample(qualityMonitorData[4], ""),
+        translate("Receive rate") + ": " + qualityReceiveRate(),
+        translate("Session received") + ": " + qualitySample(qualityMonitorData[5], "")
+    ].join("\r\n");
+}
+
+function copyPerformanceReport() {
+    var copied = handler.copy_performance_report(buildPerformanceReport());
+    showSessionToast(translate(copied ? "Copied" : "Clipboard write failed"), 1800ms);
+}
