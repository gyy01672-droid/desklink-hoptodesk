+function canUseSessionVirtualPrivacy() {
+    if (handler.session_virtual_privacy_on()) return true;
+    return pi && pi.platform == "Windows" && pi.virtual_privacy && !is_view_camera &&
+        keyboard_enabled && !handler.get_toggle_option("view-only") &&
+        handler.is_privacy_mode_supported() && !handler.get_toggle_option("privacy-mode");
+}
+
+function changeSessionVirtualPrivacy() {
+    if (handler.session_virtual_privacy_on()) {
+        handler.set_session_virtual_privacy(false);
+        return;
+    }
+    if (!canUseSessionVirtualPrivacy()) return;
+    msgbox("confirm", translate("Virtual display privacy for this session"),
+        translate("Use a virtual display and turn off physical displays for this connection? Press Ctrl+P on the host or disconnect to restore them.") + "\n\n" +
+        translate("On first use, the host may install its signed virtual display driver and trust its publisher. The driver stays installed after disconnecting."), "",
+        function(res=null) {
+            if (res != null && canUseSessionVirtualPrivacy()) handler.set_session_virtual_privacy(true);
+        }
+    );
+}
+
 function canBlockInput() {
