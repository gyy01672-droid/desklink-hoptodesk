+mod session_virtual_privacy_tests {
+    use super::LoginConfigHandler;
+
+    #[test]
+    fn explicit_activation_does_not_set_the_reconnect_option() {
+        let mut lc = LoginConfigHandler::default();
+        lc.config.privacy_mode.v = false;
+        assert!(!lc.acknowledge_session_virtual_privacy(true));
+        lc.session_virtual_privacy = Some(false);
+        assert!(lc.acknowledge_session_virtual_privacy(true));
+        assert!(lc.get_toggle_option("privacy-mode"));
+        assert!(!lc.config.privacy_mode.v);
+        assert!(lc.acknowledge_session_virtual_privacy(false));
+        assert!(!lc.get_toggle_option("privacy-mode"));
+        assert_eq!(lc.session_virtual_privacy, None);
+        lc.config.privacy_mode.v = true;
+        assert!(!lc.acknowledge_session_virtual_privacy(false));
+        assert!(lc.get_toggle_option("privacy-mode"));
+    }
+}
