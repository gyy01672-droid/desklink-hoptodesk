 impl RemoteSession {
+    fn set_session_virtual_privacy(&self, on: bool) {
+        let mut lc = self.lc.write().unwrap();
+        if on {
+            if lc.get_toggle_option("privacy-mode") {
+                return;
+            }
+            lc.session_virtual_privacy = Some(false);
+        } else if lc.session_virtual_privacy != Some(true) {
+            return;
+        }
+        drop(lc);
+        self.toggle_privacy_mode(
+            crate::privacy_mode::PRIVACY_MODE_IMPL_WIN_VIRTUAL_DISPLAY.to_owned(), on,
+        );
+    }
+
+    fn session_virtual_privacy_on(&self) -> bool {
+        self.lc.read().unwrap().session_virtual_privacy == Some(true)
+    }
