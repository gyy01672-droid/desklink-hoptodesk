+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn connected(target: u32) -> VideoQoS {
+        let mut qos = VideoQoS::default();
+        qos.users.insert(1, UserData::default());
+        qos.new_user_instant = Instant::now() - Duration::from_secs(2);
+        qos.user_custom_fps(1, target);
+        qos.adjust_fps();
+        qos
+    }
+
+    #[test]
+    fn constant_rtt_is_not_queue_growth() {
+        for baseline in [40, 220, 400] {
+            let mut user = UserDelay::default();
+            for _ in 0..RttCalculator::MIN_SAMPLES - 1 {
+                user.add_delay(baseline);
+                assert_eq!(user.avg_delay(), baseline);
+            }
+            user.add_delay(baseline);
+            assert_eq!(user.avg_delay(), 0);
+            user.add_delay(baseline + 9);
+            assert_eq!(user.avg_delay(), 3);
+        }
+    }
+
+    #[test]
+    fn stable_relay_recovers_but_queue_growth_and_timeouts_still_throttle() {
+        let mut qos = connected(60);
+        for _ in 0..45 {
+            qos.user_network_delay(1, 400);
+        }
+        assert_eq!(qos.fps(), 60);
+        for _ in 0..5 {
+            qos.user_network_delay(1, 800);
+        }
+        assert!(qos.fps() <= 5);
+        qos.user_delay_response_elapsed(1, 2100);
+        assert!(qos.fps() <= 2);
+    }
+
+    #[test]
+    fn high_refresh_recovery_respects_viewer_limits() {
+        let mut qos = connected(120);
+        for _ in 0..40 {
+            qos.user_network_delay(1, 40);
+        }
+        assert_eq!(qos.fps(), 120);
+        qos.user_auto_adjust_fps(1, 48);
+        qos.user_network_delay(1, 40);
+        assert_eq!(qos.fps(), 48);
+        qos.users.insert(2, UserData::default());
+        qos.user_custom_fps(2, 12);
+        for _ in 0..10 {
+            qos.user_network_delay(1, 40);
+            qos.user_network_delay(2, 40);
+        }
+        assert_eq!(qos.fps(), 12);
+    }
+}
