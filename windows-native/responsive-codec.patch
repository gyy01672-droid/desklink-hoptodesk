+
+fn codec_option(value: Option<&str>) -> (PreferCodec, bool) {
+    match value {
+        Some("desklink-responsive") => (PreferCodec::H264, true),
+        Some("vp8") => (PreferCodec::VP8, false),
+        Some("vp9") => (PreferCodec::VP9, false),
+        Some("h264") => (PreferCodec::H264, false),
+        Some("h265") => (PreferCodec::H265, false),
+        _ => (PreferCodec::Auto, false),
+    }
+}
+
+fn viewer_codec_vote(
+    viewer: &SupportedDecoding,
+    single_viewer: bool,
+    h264_usable: bool,
+    vp8_usable: bool,
+) -> PreferCodec {
+    let preference = viewer.prefer.enum_value_or(PreferCodec::Auto);
+    if !viewer.prefer_low_latency || preference != PreferCodec::H264 {
+        return preference;
+    }
+    // With a shared encoder only explicit codec choices vote. Auto selection
+    // and the existing hardware/decoder capability checks remain authoritative.
+    match (single_viewer, h264_usable, vp8_usable) {
+        (true, true, _) => PreferCodec::H264,
+        (true, false, true) => PreferCodec::VP8,
+        _ => PreferCodec::Auto,
+    }
+}
+
+#[cfg(test)]
+mod responsive_tests {
+    use super::*;
+    use hbb_common::protobuf::Message;
+
+    fn viewer(preference: PreferCodec, low_latency: bool) -> SupportedDecoding {
+        SupportedDecoding {
+            prefer: preference.into(),
+            prefer_low_latency: low_latency,
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn interactive_choice_observes_both_codec_capabilities() {
+        let request = viewer(PreferCodec::H264, true);
+        for (h264, vp8, want) in [
+            (true, true, PreferCodec::H264), (true, false, PreferCodec::H264),
+            (false, true, PreferCodec::VP8), (false, false, PreferCodec::Auto),
+        ] {
+            assert_eq!(viewer_codec_vote(&request, true, h264, vp8), want);
+            assert_eq!(viewer_codec_vote(&request, false, h264, vp8), PreferCodec::Auto);
+        }
+    }
+
+    #[test]
+    fn explicit_viewers_and_recording_keep_the_existing_vote() {
+        for pref in [PreferCodec::VP8, PreferCodec::VP9, PreferCodec::H265,
+                     PreferCodec::H264, PreferCodec::Auto] {
+            assert_eq!(viewer_codec_vote(&viewer(pref, false), false, false, true), pref);
+        }
+        assert_eq!(viewer_codec_vote(&viewer(PreferCodec::Auto, false), true, false, true),
+                   PreferCodec::Auto);
+    }
+
+    #[test]
+    fn preset_values_and_legacy_wire_preference() {
+        for (key, kind) in [(None, PreferCodec::Auto), (Some("auto"), PreferCodec::Auto),
+                            (Some("vp8"), PreferCodec::VP8), (Some("vp9"), PreferCodec::VP9),
+                            (Some("h265"), PreferCodec::H265), (Some("h264"), PreferCodec::H264)] {
+            assert_eq!(codec_option(key), (kind, false));
+        }
+        let (codec, flag) = codec_option(Some("desklink-responsive"));
+        assert_eq!((codec, flag), (PreferCodec::H264, true));
+        // The unchanged wire prefix is field 4 = H264. Old senders omit field 100.
+        let old = [0x20, 0x02];
+        let legacy = SupportedDecoding::parse_from_bytes(&old).unwrap();
+        assert!(!legacy.prefer_low_latency);
+        assert_eq!(legacy.prefer.enum_value_or_default(), PreferCodec::H264);
+        let new = [0x20, 0x02, 0xa0, 0x06, 0x01];
+        assert_eq!(viewer(codec, flag).write_to_bytes().unwrap(), new);
+        assert!(SupportedDecoding::parse_from_bytes(&new).unwrap().prefer_low_latency);
     }
 }
 
