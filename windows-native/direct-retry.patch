diff --git a/src/direct_probe/retry.rs b/src/direct_probe/retry.rs
new file mode 100644
index 0000000..4409dd6
--- /dev/null
+++ b/src/direct_probe/retry.rs
@@ -0,0 +1,78 @@
+use std::{
+    sync::{Arc, OnceLock},
+    time::{Duration, Instant},
+};
+
+pub(super) const PROTOCOL_VERSION: u32 = 3;
+const SLOW_MS: u32 = 150;
+const WAIT: Duration = Duration::from_secs(30);
+const MAX_SAMPLE_GAP: Duration = Duration::from_secs(5);
+
+#[derive(Clone, Default)]
+pub(super) struct RetryPermit(Arc<OnceLock<Instant>>);
+
+impl RetryPermit {
+    pub(super) fn record_miss(&self, first_attempt: bool, version: u32, now: Instant) {
+        if first_attempt && version >= PROTOCOL_VERSION {
+            let _ = self.0.set(now);
+        }
+    }
+
+    pub(super) fn ready(&self, now: Instant) -> bool {
+        self.0.get().is_some_and(|at| now.saturating_duration_since(*at) >= WAIT)
+    }
+}
+
+#[derive(Default)]
+pub(super) struct SlowRelay {
+    first: Option<Instant>,
+    last: Option<Instant>,
+}
+
+impl SlowRelay {
+    pub(super) fn observe(&mut self, ms: u32, now: Instant) -> bool {
+        if ms < SLOW_MS {
+            *self = Self::default();
+            return false;
+        }
+        if self.last.is_some_and(|at| now.saturating_duration_since(at) > MAX_SAMPLE_GAP) {
+            self.first = None;
+        }
+        self.last = Some(now);
+        now.saturating_duration_since(*self.first.get_or_insert(now)) >= WAIT
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn an_authenticated_first_exchange_can_only_enable_one_later_attempt() {
+        let t = Instant::now();
+        for (first, version) in [(true, 2), (false, 3), (false, 4)] {
+            let permit = RetryPermit::default();
+            permit.record_miss(first, version, t);
+            assert!(!permit.ready(t + WAIT * 2));
+        }
+        let permit = RetryPermit::default();
+        assert!(!permit.ready(t + WAIT));
+        permit.record_miss(true, 3, t);
+        assert!(!permit.ready(t + WAIT - Duration::from_millis(1)));
+        assert!(permit.ready(t + WAIT));
+    }
+
+    #[test]
+    fn sustained_slow_relay_requires_continuous_fresh_reports() {
+        let t = Instant::now();
+        let mut slow = SlowRelay::default();
+        for s in 0..30 {
+            assert!(!slow.observe(400, t + Duration::from_secs(s)));
+        }
+        assert!(slow.observe(400, t + WAIT));
+        assert!(!slow.observe(40, t + WAIT));
+        assert!(!slow.observe(400, t + WAIT + Duration::from_secs(1)));
+        assert!(!slow.observe(400, t + WAIT * 2));
+        assert!(!slow.observe(0, t + WAIT * 3));
+    }
+}
